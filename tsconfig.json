{
  "compilerOptions": {
    "target": "ES2024",
    "useDefineForClassFields": true,
    "lib": [
      "ES2021",
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "types": [
      "vite/client",
      "@testing-library/jest-dom"
    ],
    "module": "es2022",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    /* Paths */
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "#components/*": [
        "./src/components/*"
      ],
      "#pages/*": [
        "./src/pages/*"
      ],
      "#styles/*": [
        "./src/styles/*"
      ],
      "#assets/*": [
        "./src/assets/*"
      ],
      "#providers/*": [
        "./src/providers/*"
      ],
      "#lib/*": [
        "./src/lib/*"
      ],
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "tools/",
    "dist/server/"
  ],
}
