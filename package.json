{
  "name": "short-lasting-silence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./tools/devServer",
    "build": "bun run build:client && bun run build:server",
    "build:client": "cross-env NODE_ENV=production bun run --bun vite build --ssrManifest --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production bun run --bun vite build --ssr src/entryServer.tsx --outDir dist/server",
    "prerender": "bun run build && cross-env NODE_ENV=production bun ./tools/prerenderPages.ts",
    "preview": "bun run prerender && cross-env NODE_ENV=production bun ./tools/staticServer",
    "lint": "bun run --bun biome check --write",
    "test": "bun run --bun vitest",
    "visualize": "bun run --bun vite-bundle-visualizer -o bundle.html",
    "fetch-symbols": "bun run ./tools/fetchMaterialSymbols"
  },
  "dependencies": {
    "@solid-primitives/scheduled": "^1.5.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "@trpc/client": "^11.5.0",
    "@trpc/server": "^11.5.0",
    "@types/cors": "^2.8.19",
    "@types/gapi": "^0.0.47",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "google-spreadsheet": "^5.0.2",
    "music-metadata": "^11.3.0",
    "pure-rand": "^7.0.1",
    "solid-js": "^1.9.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.3",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/bun": "^1.2.17",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.23",
    "@types/nunjucks": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.4",
    "compression": "^1.8.0",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "glob": "^11.0.3",
    "jsdom": "^26.1.0",
    "nunjucks": "^3.2.4",
    "sass-embedded": "^1.89.2",
    "sirv": "^3.0.1",
    "terser": "^5.43.1",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.4.0+sha1.9217c800d4ab947a7aee520242a7b70d64fc7638"
}