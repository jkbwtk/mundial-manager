{
  "name": "mundial-manager",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/entryServer.d.ts",
      "module": "./dist/server/entryServer.js"
    }
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env ./tools/devServer",
    "build": "pnpm build:server && pnpm build:client && pnpm build:backend",
    "build:client": "cross-env NODE_ENV=production vite build --ssrManifest --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production vite build --ssr frontend/entryServer.tsx --outDir dist/server",
    "build:backend": "cross-env NODE_ENV=production rollup -c",
    "prerender": "pnpm build && cross-env NODE_ENV=production tsx --env-file-if-exists=.env ./tools/prerenderPages.ts",
    "preview": "pnpm prerender && cross-env NODE_ENV=production tsx --env-file-if-exists=.env ./tools/staticServer",
    "lint": "biome check --write",
    "test": "vitest",
    "visualize": "vite-bundle-visualizer -o bundle.html",
    "fetch-symbols": "tsx --env-file-if-exists=.env ./tools/fetchMaterialSymbols",
    "cli": "tsx --env-file-if-exists=.env ./tools/cli"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "@solid-primitives/scheduled": "^1.5.2",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@trpc/client": "^11.8.0",
    "@trpc/server": "^11.8.0",
    "@types/cors": "^2.8.19",
    "@types/gapi": "^0.0.47",
    "chalk": "^4.1.2",
    "chart.js": "^4.5.1",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "figlet": "^1.9.4",
    "google-spreadsheet": "^5.0.2",
    "highlight.js": "^11.11.1",
    "music-metadata": "^11.10.3",
    "pure-rand": "^7.0.1",
    "safe-stable-stringify": "^2.5.0",
    "semver": "^7.7.3",
    "solid-js": "^1.9.10",
    "solid-transition-group": "^0.3.0",
    "stable-hash": "^0.0.6",
    "workbox-window": "^7.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.9",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/compression": "^1.8.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.25",
    "@types/nunjucks": "^3.2.6",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^3.2.4",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "express": "^4.22.1",
    "glob": "^11.1.0",
    "google-auth-library": "^10.5.0",
    "jsdom": "^26.1.0",
    "nunjucks": "^3.2.4",
    "rollup": "^4.53.4",
    "sass-embedded": "^1.96.0",
    "sirv": "^3.0.2",
    "terser": "^5.44.1",
    "tsx": "^4.21.0",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^3.2.4",
    "workbox-build": "^7.4.0"
  },
  "packageManager": "pnpm@9.4.0+sha1.9217c800d4ab947a7aee520242a7b70d64fc7638"
}