{
  "name": "mundial-manager",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/entryServer.d.ts",
      "module": "./dist/server/entryServer.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env ./backend/devServer",
    "worker": "tsx watch --env-file-if-exists=.env ./backend/worker",
    "dev:static": "cross-env NODE_ENV=production tsx watch --env-file-if-exists=.env ./backend/server",
    "static": "cross-env NODE_ENV=production tsx --env-file-if-exists=.env ./dist/backend/server",
    "playground": "tsx watch --env-file-if-exists=.env ./backend/playground",
    "build": "pnpm build:server && pnpm build:client && pnpm build:backend",
    "build:client": "cross-env NODE_ENV=production vite build --ssrManifest --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production vite build --ssr frontend/entryServer.tsx --outDir dist/server",
    "build:backend": "cross-env NODE_ENV=production rolldown -c",
    "prerender": "pnpm build && cross-env NODE_ENV=production tsx --env-file-if-exists=.env ./tools/prerenderPages.ts",
    "preview": "pnpm prerender && pnpm static",
    "lint": "biome check --write",
    "test": "vitest",
    "visualize": "vite-bundle-visualizer -o bundle.html",
    "cli": "tsx --env-file-if-exists=.env ./tools/cli"
  },
  "dependencies": {
    "@colors/colors": "^1.6.1",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@types/cors": "^2.8.19",
    "@types/gapi": "^0.0.47",
    "amqplib": "^2.0.1",
    "chalk": "^6.0.0",
    "chart.js": "^4.5.1",
    "commander": "^15.0.0",
    "cookies": "^0.9.2",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "drizzle-orm": "1.0.0-rc.4",
    "echarts": "^6.0.0",
    "figlet": "^1.11.4",
    "google-spreadsheet": "^5.2.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.12.0",
    "jdenticon": "^3.3.0",
    "jose": "^6.2.12",
    "music-metadata": "^11.15.0",
    "on-finished": "^2.4.1",
    "on-headers": "^1.1.0",
    "penpal": "^8.0.1",
    "pg": "^8.23.0",
    "pure-rand": "^8.4.2",
    "safe-stable-stringify": "^2.5.0",
    "semver": "^7.7.4",
    "solid-js": "^1.9.15",
    "solid-transition-group": "^0.3.0",
    "stable-hash": "^0.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@biomejs/biome": "2.5.14",
    "@faker-js/faker": "^10.6.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/compression": "^1.8.1",
    "@types/cookies": "^0.9.2",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^26.6.1",
    "@types/nunjucks": "^3.2.6",
    "@types/on-finished": "^2.3.5",
    "@types/on-headers": "^1.0.4",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.1",
    "change-case": "^5.4.4",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "google-auth-library": "^11.1.0",
    "jsdom": "^30.0.1",
    "nunjucks": "^3.2.4",
    "postcss": "^8.5.28",
    "postcss-modules": "^9.0.1",
    "rolldown": "1.2.9",
    "sass-embedded": "^1.104.1",
    "sirv": "^3.0.2",
    "terser": "^5.51.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}