{
  "name": "mundial-manager",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/entryServer.d.ts",
      "module": "./dist/server/entryServer.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env ./tools/devServer",
    "playground": "tsx watch --env-file-if-exists=.env ./backend/playground",
    "build": "pnpm build:server && pnpm build:client && pnpm build:backend",
    "build:client": "cross-env NODE_ENV=production vite build --ssrManifest --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production vite build --ssr frontend/entryServer.tsx --outDir dist/server",
    "build:backend": "cross-env NODE_ENV=production rollup -c",
    "prerender": "pnpm build && cross-env NODE_ENV=production tsx --env-file-if-exists=.env ./tools/prerenderPages.ts",
    "preview": "pnpm prerender && cross-env NODE_ENV=production tsx --env-file-if-exists=.env ./tools/staticServer",
    "lint": "biome check --write",
    "test": "vitest",
    "visualize": "vite-bundle-visualizer -o bundle.html",
    "fetch-symbols": "tsx --env-file-if-exists=.env ./tools/fetchMaterialSymbols",
    "cli": "tsx --env-file-if-exists=.env ./tools/cli"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.1",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@types/cors": "^2.8.19",
    "@types/gapi": "^0.0.47",
    "chalk": "^5.6.2",
    "chart.js": "^4.5.1",
    "commander": "^14.0.3",
    "cookies": "^0.9.1",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "discord.js": "^14.26.3",
    "drizzle-orm": "1.0.0-beta.22",
    "echarts": "^6.0.0",
    "figlet": "^1.11.0",
    "google-spreadsheet": "^5.2.0",
    "highlight.js": "^11.11.1",
    "jdenticon": "^3.3.0",
    "music-metadata": "^11.12.3",
    "pg": "^8.20.0",
    "pure-rand": "^8.4.0",
    "safe-stable-stringify": "^2.5.0",
    "semver": "^7.7.4",
    "solid-js": "^1.9.12",
    "solid-transition-group": "^0.3.0",
    "stable-hash": "^0.0.6",
    "workbox-window": "^7.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/compression": "^1.8.1",
    "@types/cookies": "^0.9.2",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.20.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.5",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-beta.23",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "google-auth-library": "^10.6.2",
    "jsdom": "^29.0.2",
    "nunjucks": "^3.2.4",
    "rollup": "^4.60.2",
    "sass-embedded": "^1.99.0",
    "sirv": "^3.0.2",
    "terser": "^5.46.2",
    "tsx": "^4.21.0",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.5",
    "workbox-build": "^7.4.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}