{
  "name": "mundial-manager",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/entryServer.d.ts",
      "module": "./dist/server/entryServer.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env ./backend/devServer",
    "worker": "tsx watch --env-file-if-exists=.env ./backend/worker",
    "dev:static": "cross-env NODE_ENV=production tsx watch --env-file-if-exists=.env ./backend/server",
    "static": "cross-env NODE_ENV=production tsx --env-file-if-exists=.env ./dist/backend/server",
    "playground": "tsx watch --env-file-if-exists=.env ./backend/playground",
    "build": "pnpm build:server && pnpm build:client && pnpm build:backend",
    "build:client": "cross-env NODE_ENV=production vite build --ssrManifest --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production vite build --ssr frontend/entryServer.tsx --outDir dist/server",
    "build:backend": "cross-env NODE_ENV=production rolldown -c",
    "prerender": "pnpm build && cross-env NODE_ENV=production tsx --env-file-if-exists=.env ./tools/prerenderPages.ts",
    "preview": "pnpm prerender && pnpm static",
    "lint": "biome check --write",
    "visualize": "vite-bundle-visualizer -o bundle.html",
    "cli": "tsx --env-file-if-exists=.env ./tools/cli"
  },
  "dependencies": {
    "@colors/colors": "^1.6.1",
    "@solid-primitives/deep": "^0.3.7",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.1",
    "@trpc/client": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@types/cors": "^2.8.19",
    "@types/gapi": "^0.0.47",
    "amqplib": "^2.2.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "cookies": "^0.9.2",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "drizzle-orm": "1.0.0-rc.4",
    "echarts": "^6.0.0",
    "figlet": "^1.12.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.12.0",
    "jdenticon": "^3.3.0",
    "jose": "^6.2.14",
    "music-metadata": "^12.3.3",
    "on-finished": "^2.4.2",
    "on-headers": "^1.1.0",
    "penpal": "^8.0.1",
    "pg": "^8.23.1",
    "pure-rand": "^8.4.2",
    "safe-stable-stringify": "^3.0.0",
    "semver": "^7.7.4",
    "solid-js": "^1.9.18",
    "solid-transition-group": "^0.3.0",
    "stable-hash": "^0.0.6",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@biomejs/biome": "2.6.4",
    "@faker-js/faker": "^10.6.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/amqplib": "^0.10.8",
    "@types/compression": "^1.8.1",
    "@types/cookies": "^0.9.2",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "@types/on-finished": "^2.3.5",
    "@types/on-headers": "^1.0.4",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "change-case": "^5.4.4",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "1.0.0-rc.4",
    "express": "^5.3.0",
    "fontverter": "2.0.0",
    "glob": "^14.0.3",
    "harfbuzzjs": "0.10.3",
    "nunjucks": "^3.2.4",
    "postcss": "^8.5.32",
    "postcss-modules": "^9.0.1",
    "rolldown": "1.2.16",
    "sass-embedded": "^1.107.1",
    "sirv": "^3.0.2",
    "subset-font": "^2.9.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.15"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}